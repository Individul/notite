---
// Calendarul: un panou langa butonul care il deschide, deci la indemana cursorului.
// Cand ecranul e destul de lat se aseaza in marginea libera din dreapta textului, ca sa
// nu acopere notita; pe ecrane mai inguste cade sub buton, unde n-are incotro.
//
// Cat e deschis poti sari din zi in zi si vedea pe loc ce ai planificat pentru fiecare,
// ca sa stii daca mai incape ceva acolo.
//
// Starea „deschis" traieste in adresa (`?luna=`), iar zilele si sagetile sunt linkuri
// obisnuite care o duc mai departe. Deci panoul ramane deschis dupa ce alegi o zi si
// merge intreg fara JavaScript; clicul in afara lui, care il inchide, e doar un adaos.
import { env } from "cloudflare:workers";
import { zileScrise } from "../lib/db";
import { aziChisinau } from "../lib/data";
import { grilaLunii, ZILE_SAPTAMANA } from "../lib/calendar";

interface Props {
  zi: string;
  luna: string;
}
const { zi, luna } = Astro.props;

const azi = aziChisinau();
const grila = grilaLunii(luna);
const scrise = new Set(
  await zileScrise(env.DB, Astro.locals.email, grila.zile[0]?.data ?? zi, grila.zile.at(-1)?.data ?? zi)
);

const adresaZi = (z: string) => `${z === azi ? "/" : `/zi/${z}`}?luna=${grila.luna}`;
const adresaLuna = (l: string) => `${Astro.url.pathname}?luna=${l}`;
---

<aside class="panou" aria-label="Calendar">
  <div class="cap">
    <a href={adresaLuna(grila.anterioara)} aria-label="Luna anterioară">←</a>
    <strong>{grila.eticheta}</strong>
    <a href={adresaLuna(grila.urmatoare)} aria-label="Luna următoare">→</a>
  </div>
  <div class="grila">
    {ZILE_SAPTAMANA.map((z) => <span class="cap-zi">{z}</span>)}
    {grila.zile.map((z) => (
      <a
        href={adresaZi(z.data)}
        class:list={[
          "zi",
          {
            "alta-luna": !z.inLuna,
            azi: z.data === azi,
            activ: z.data === zi,
            scrisa: scrise.has(z.data),
          },
        ]}
        aria-current={z.data === zi ? "page" : undefined}
      >
        {z.numar}
      </a>
    ))}
  </div>
</aside>

<script is:inline>
  // Un clic oriunde in afara calendarului si a butonului care il deschide il inchide, si
  // scoate `?luna=` din adresa, ca o navigare de mai tarziu sa nu-l readuca nechemat.
  // Fara JavaScript panoul ramane deschis pana apesi butonul din antet — tot o cale buna.
  (function () {
    var panou = document.querySelector("aside.panou");
    if (!panou) return;
    document.addEventListener("click", function (e) {
      var t = e.target;
      if (!(t instanceof Element)) return;
      if (panou.contains(t) || t.closest(".comuta-calendar")) return;
      panou.hidden = true;
      var u = new URL(location.href);
      u.searchParams.delete("luna");
      history.replaceState(null, "", u.pathname + u.search);
      // Butonul a fost randat cand calendarul era deschis: acum trebuie sa-l redeschida.
      var buton = document.querySelector(".comuta-calendar");
      if (buton) {
        buton.setAttribute("aria-expanded", "false");
        var eticheta = buton.querySelector("span");
        if (eticheta) eticheta.textContent = "Alege ziua";
        if (buton.dataset.luna) buton.setAttribute("href", u.pathname + "?luna=" + buton.dataset.luna);
      }
    });
  })();
</script>

<style is:global>
  /* Global fiindca ancora panoului sta in antetul zilei (PaginaZi.astro). */
  .panou {
    position: absolute; z-index: 30; width: 292px; padding: 14px;
    top: calc(100% + 8px); right: 0;
    border: 1px solid var(--line); border-radius: 16px;
    background: var(--bg-2); box-shadow: 0 20px 48px rgba(0, 0, 0, 0.55);
  }
  /* De aici incolo, marginea din dreapta textului e destul de lata cat sa tina panoul:
     il mutam langa buton, ca sa ramana la indemana cursorului fara sa acopere notita.
     Pragul iese din 300px lista + 760px continut + panoul si spatiul lui, de doua ori,
     fiindca `.continut` e centrat in coloana lui. */
  @media (min-width: 1680px) {
    .panou { top: -8px; left: calc(100% + 18px); right: auto; }
  }

  .panou .cap { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .panou .cap strong { font-family: var(--display); font-size: 14.5px; font-weight: 600; color: var(--text); }
  .panou .cap strong::first-letter { text-transform: uppercase; }
  .panou .cap a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; border-radius: 9px; color: var(--muted); font-size: 15px;
  }
  .panou .cap a:hover { background: var(--line); color: var(--text); }

  .panou .grila { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .panou .cap-zi {
    text-align: center; padding: 3px 0 5px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.04em; color: var(--faint);
  }
  .panou .zi {
    position: relative; display: flex; align-items: center; justify-content: center;
    height: 33px; padding-bottom: 3px; border-radius: 10px;
    font-size: 13px; font-weight: 600; color: var(--text-2);
  }
  .panou .zi:hover { background: var(--line); color: var(--text); }
  .panou .zi.alta-luna { color: var(--faint); font-weight: 500; }
  .panou .zi.azi { color: var(--violet); }
  .panou .zi.activ { background: rgba(179, 147, 242, 0.2); color: var(--violet); }
  /* Punctul spune ca ziua are text scris: se vede dintr-o privire unde ai notite. */
  .panou .zi.scrisa::after {
    content: ""; position: absolute; bottom: 5px; left: 50%; transform: translateX(-50%);
    width: 4px; height: 4px; border-radius: 50%; background: var(--violet);
  }
  .panou .zi.alta-luna.scrisa::after { background: var(--faint); }
</style>
