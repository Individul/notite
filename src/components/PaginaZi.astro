---
// Notita unei zile: antet (Azi / Ieri / Maine / ziua saptamanii + data lunga), butonul
// care deschide calendarul si editorul. Sagetile din bara merg din zi in zi; calendarul
// sare direct la o data, ca sa poti scrie dinainte pentru o zi oarecare.
//
// Calendarul (Calendar.astro) se agata de butonul asta, ca sa fie la indemana cursorului;
// butonul doar pune sau scoate `?luna=` din adresa, deci deschiderea merge fara JavaScript.
import type { Nota } from "../lib/db";
import { etichetaZi, fmtZi } from "../lib/data";
import { lunaValida, lunaZilei } from "../lib/calendar";
import Calendar from "./Calendar.astro";
import Editor from "./Editor.astro";

interface Props {
  nota: Nota;
  data: string;
}
const { nota, data } = Astro.props;

const luna = Astro.url.searchParams.get("luna") ?? "";
const deschis = lunaValida(luna);
const comuta = deschis ? Astro.url.pathname : `${Astro.url.pathname}?luna=${lunaZilei(data)}`;
---

<header class="antet-zi">
  <div>
    <p class="eticheta">{etichetaZi(data)}</p>
    <h1>{fmtZi(data)}</h1>
  </div>

  <div class="ancora">
    <a
      class="buton comuta-calendar"
      href={comuta}
      aria-expanded={deschis ? "true" : "false"}
      data-luna={lunaZilei(data)}
    >
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <rect x="2" y="3.2" width="12" height="10.6" rx="2.6" />
        <path d="M2 6.5h12M5.4 1.8v2.6M10.6 1.8v2.6" />
      </svg>
      <span>{deschis ? "Ascunde calendarul" : "Alege ziua"}</span>
    </a>
    {deschis && <Calendar zi={data} luna={luna} />}
  </div>
</header>

<Editor nota={nota} focus />

<style>
  .antet-zi {
    margin-bottom: 18px; display: flex; align-items: flex-end; justify-content: space-between;
    gap: 12px; flex-wrap: wrap;
  }
  .eticheta {
    margin: 0 0 4px; font-size: 13px; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--violet);
  }
  h1 {
    margin: 0; font-family: var(--display); font-weight: 600; font-size: 28px;
    letter-spacing: -0.01em; line-height: 1.15;
  }
  h1::first-letter { text-transform: uppercase; }

  /* Ancora panoului: calendarul se aseaza fata de butonul asta, nu fata de pagina. */
  .ancora { position: relative; }
  .comuta-calendar { padding: 6px 13px; font-size: 13px; }
  .comuta-calendar svg {
    width: 15px; height: 15px; fill: none; stroke: currentColor;
    stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;
  }
  .comuta-calendar[aria-expanded="true"] { border-color: var(--violet); color: var(--violet); }
</style>
