---
// Notita unei zile: antet (Azi / Ieri / Maine / ziua saptamanii + data lunga), selectorul
// de zi si editorul. Sagetile din bara merg din zi in zi; de aici sari direct la o data,
// ca sa poti scrie dinainte pentru o zi oarecare.
import type { Nota } from "../lib/db";
import { etichetaZi, fmtZi } from "../lib/data";
import Editor from "./Editor.astro";

interface Props {
  nota: Nota;
  data: string;
}
const { nota, data } = Astro.props;
---

<header class="antet-zi">
  <div>
    <p class="eticheta">{etichetaZi(data)}</p>
    <h1>{fmtZi(data)}</h1>
  </div>
  <form class="sari" action="/zi" method="get">
    <label class="doar-citit" for="alege-zi">Sari la o zi</label>
    <input id="alege-zi" type="date" name="data" value={data} />
    <button type="submit" class="buton mergi">Mergi</button>
  </form>
</header>
<Editor nota={nota} focus />

<script is:inline>
  // Cu JavaScript, alegerea datei duce direct acolo, deci butonul devine de prisos.
  // Fara el, formularul ramane unul obisnuit si butonul face treaba.
  (function () {
    var f = document.querySelector("form.sari");
    if (!f) return;
    var buton = f.querySelector("button");
    var camp = f.querySelector("input[type=date]");
    if (buton) buton.hidden = true;
    if (camp) camp.addEventListener("change", function () { f.submit(); });
  })();
</script>

<style>
  .antet-zi {
    margin-bottom: 18px; display: flex; align-items: flex-end; justify-content: space-between;
    gap: 12px; flex-wrap: wrap;
  }
  .eticheta {
    margin: 0 0 4px; font-size: 13px; font-weight: 600; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--violet);
  }
  h1 {
    margin: 0; font-family: var(--display); font-weight: 600; font-size: 28px;
    letter-spacing: -0.01em; line-height: 1.15;
  }
  h1::first-letter { text-transform: uppercase; }

  .sari { display: flex; align-items: center; gap: 8px; }
  .sari input {
    font: inherit; font-size: 13px; font-weight: 600; padding: 6px 12px;
    border: 1px solid var(--line); border-radius: 999px; background: transparent;
    color: var(--text-2); outline: none; cursor: pointer;
  }
  .sari input:hover { border-color: var(--violet); }
  .sari input:focus-visible { border-color: var(--violet); }
  .mergi { padding: 6px 12px; font-size: 13px; }
  /* Eticheta exista pentru cititoarele de ecran; pe ecran o spune deja campul insusi. */
  .doar-citit {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }
</style>
